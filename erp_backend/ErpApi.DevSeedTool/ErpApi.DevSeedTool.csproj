<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <!-- ‏نفس معرّف أسرار ErpApi عمداً: الأداة تقرأ سلسلة الاتصال نفسها التي يقرأها
         الخادم، فلا مخزن أسرار ثانٍ ينحرف عنه ولا قيمة تُكرَّر -->
    <UserSecretsId>33336265-3d01-4520-b129-c281ba593084</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErpApi\ErpApi.csproj" />
  </ItemGroup>

</Project>
